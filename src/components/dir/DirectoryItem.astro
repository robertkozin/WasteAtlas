---
import type { CollectionEntry } from "astro:content"
import type { AllWastes } from "@pages/_data"
interface Props {
  waste: AllWastes[number]
}

const { waste } = Astro.props
---

<!-- plantilla de cada tarjeta  --><!--<li class="item">{waste.name}..{waste.category}</li> -->
<a href={`/waste/${waste.slug}`} class="directory-card" data-category={waste.category + " " + waste.tags.join(" ")} data-tags={waste.tags.join(" ")}>
  <div class="card-image">
    <img src={waste.image_url} alt={waste.name} />
  </div>
  <div class="card-content">
    <p class="card-title">{waste.project?.name}</p>
    <p class="card-location">{waste.location}</p>
    <p class="card-name">{waste.name}</p>
  </div>
</a>

<style>
 

  .directory-card {
    border: 2px solid black;
    background: transparent;
    cursor: pointer;
    display: flex;
    flex-direction: row;
    /*esto para hacer transicion suave */
      opacity: 1;
      transition: opacity 0.4s ease;
    /*max-width: 500px; este tamaño no es tan alargao pero no encajan asi claro:)*/
  }
      /*transicion de arriba continua aqui */
      .directory-card.hidden {
        opacity: 0;
      }

  .card-image {
    width: 140px;
    height: 110px;
    overflow: hidden;
    flex-shrink: 0;
    padding: 8px;
    box-sizing: border-box;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 2px solid black;
  }

  .card-content {
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-title {
    font-weight: bold;
    margin: 0;
    font-size: 18px;
  }

  .card-location {
    margin: 3px 0;
    font-size: 13px;
    color: #666;
  }

  .card-name {
    margin: 4px 0;
    font-size: 12px;
    font-weight: 600;
  }

   .hiding {
    display: none;
  }
</style>
