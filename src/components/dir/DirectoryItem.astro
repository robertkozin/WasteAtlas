<!-- plantilla de cada tarjeta  -->

---
import type { CollectionEntry } from "astro:content"

interface Props {
  waste: CollectionEntry<"wastes">["data"]
}

const { waste } = Astro.props
---
<!--<li class="item">{waste.name}..{waste.category}</li> -->

<div class="directory-card" data-category={waste.category}>
  <div class="card-image">
    <img src={waste.image_url} alt={waste.name} />
  </div>
  <div class="card-content">
    <p class="card-title">Waste</p>
    <p class="card-location">{waste.location}</p>
    <p class="card-name">{waste.name}</p>
  </div>
</div>

<style>
  .directory-card {
    border: 2px solid black;
    background: rgba(255, 255, 255, 0.9);
    cursor: pointer;
    height: 180px;
    display: flex;
    flex-direction: column;
  }

  .card-image {
    width: 100%;
    height: 90px;
    border-bottom: 2px solid black;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-content {
    padding: 10px;
    flex: 1;
  }

  .card-title {
    font-weight: bold;
    margin: 0;
    font-size: 12px;
  }

  .card-location {
    margin: 3px 0;
    font-size: 11px;
    color: #666;
  }

  .card-name {
    margin: 3px 0;
    font-size: 12px;
    font-weight: 600;
  }
</style>
