<style>
  .directory-page {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(200, 200, 220, 0.6);
    backdrop-filter: blur(3px);
  }

  .directory-container {
    display: flex;
    height: 100%;
  }

  .filters-panel {
    width: 200px;
    padding: 20px;
    background: transparent;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }

  .directory-title {
    font-size: 30px; /*QUE TAMAÑO??????? */
    margin: 0 0 20px 0;
  }

  .filters-panel h3 {
    margin: 15px 0 8px 0;
    font-size: 14px;
    font-weight: normal;
  }

  .filter-list {
    list-style: none;
    padding: 0;
    margin: 0 0 0 15px;
  }

  .filter-list li {
    margin: 0;
  }

  .filter-btn {
    background: none;
    border: none;
    padding: 2px 0;
    cursor: pointer;
    font-size: 10px;
    text-align: left;
  }

  .filter-btn:hover {
    text-decoration: underline;
  }


  .atlas-link {
    margin-top: auto;
    text-decoration: none;
    color: black;
    font-size: 18px;
    padding-bottom: 2px;
    align-self: flex-start;
    background: linear-gradient(to top, yellow 80%);
    text-decoration: underline;
  }

      /*.atlas-link:hover {
        ??
      }*/



  .cards-grid { /*las dos columnitas separadas */
    flex: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr); /*probar con 2-3 */
    gap: 15px;
    padding: 20px;
    overflow-y: scroll;
    overflow-x: hidden;
    
  }

 /*scroll PARA LOLA. COPIAR ESTO */
  .cards-grid::-webkit-scrollbar {
    width: 14px;
  }

  .cards-grid::-webkit-scrollbar-thumb {
    background: yellow;
    border: 2px solid black;
    border-radius: 10px;
  }

</style>

