<style is:global>
  .title-area.panel {
    top: 10px;
    left: 10px;
    padding: 18px 20px;
    max-width: 564px;
    border-radius: 30px;
    transition: display 1s;
    background-color:  yellow;
    box-shadow: 0 0 40px rgba(255, 255, 0, 0.6);
    color: black;
  }

  .title-area h1 {
    text-transform: uppercase;
    font-size: 32px;
    font-weight: 500;
    line-height: 1;
    margin: 0;
    color: black;
  }

  .title-area button.toggle-btn {
    position: absolute;
    right: 15px;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    width: auto;
    height: auto;
    font-size:24px;
    cursor: pointer;
    color: black;
  }

